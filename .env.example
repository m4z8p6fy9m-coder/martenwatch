# Configure these on the server; do not commit actual credentials.
# Foundry requests can incur charges. Disabled by default; never enable in CI.
FOUNDRY_ENABLE_PAID_CALLS=false
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_AGENT_NAME=your-agent-name
# PostgreSQL connection string; use TLS for Azure and keep credentials out of source control.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
